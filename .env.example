# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Core --------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-50-character-random-string
DEBUG=True
# Comma separated. Required when DEBUG=False.
ALLOWED_HOSTS=

# Public URLs -------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# CORS / CSRF -------------------------------------------------------------
# Comma separated list of frontend origins allowed to call this API.
# NEVER use a wildcard here in production.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Cookies -----------------------------------------------------------------
# Both default correctly from DEBUG: secure cookies off in development, on in
# production. Set these only to override that — e.g. COOKIE_SECURE=False for a
# local http setup. Never set COOKIE_SECURE=False in production.
# COOKIE_SECURE=False
# COOKIE_SAMESITE=Lax

# Database ----------------------------------------------------------------
# Defaults to SQLite. For MySQL/Postgres set DB_ENGINE and the rest.
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=mindful_blog
# DB_USER=blog
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# JWT ---------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Email -------------------------------------------------------------------
# Leave EMAIL_HOST_USER/PASSWORD blank to print emails to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@mindfulblog.local
SITE_NAME=Mindful Blog
# Set to False to let users log in without confirming the emailed code.
REQUIRE_EMAIL_VERIFICATION=True
LOGIN_CODE_TTL_MINUTES=10

# Throttling --------------------------------------------------------------
THROTTLE_USER=2000/day
THROTTLE_ANON=300/day
THROTTLE_AUTH=20/hour
THROTTLE_REGISTER=10/hour
THROTTLE_WRITE=120/hour

# Uploads -----------------------------------------------------------------
MAX_IMAGE_UPLOAD_SIZE=5242880

# Pagination --------------------------------------------------------------
PAGE_SIZE=10

# GitHub OAuth (optional) -------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_SECRET=
