# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Core --------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-50-character-random-string
DEBUG=True
# Comma separated. Required when DEBUG=False.
ALLOWED_HOSTS=http://127.0.0.1:8000,

# Public URLs -------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Owner account -----------------------------------------------------------
# Used by `manage.py seed_admin` (and so by `seed_all` and build.sh) to create
# the super admin without a prompt — `createsuperuser` asks questions, which is
# useless in a deploy's build step where there is no console.
#
# Leave these blank and the behaviour splits on DEBUG:
#   DEBUG=True  -> falls back to admin@example.com / MindfulAdmin!2024 (username
#                  "admin") and prints it, so a fresh clone can sign in at once.
#   DEBUG=False -> the seed reports itself skipped and exits 0, so a build
#                  script can always call it and no deploy gets a known password.
#
# The password must pass Django's validators, and an account that already
# exists keeps the password it has unless you run `seed_admin --force-password`.
#
# On Render, set these as environment variables on the service — not in a file.


# CORS / CSRF -------------------------------------------------------------
# Comma separated list of frontend origins allowed to call this API.
# NEVER use a wildcard here in production.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Cookies -----------------------------------------------------------------
# Nothing to set. Cookie and transport security are derived from DEBUG alone:
# DEBUG=False means the site is behind HTTPS, so Secure cookies, SameSite=None,
# the https redirect and HSTS all switch on together. There is no override,
# because the only thing one could express is "send my session cookies in the
# clear". If you need plain-http cookies locally, that is what DEBUG=True is.

# Database ----------------------------------------------------------------
# Defaults to SQLite. For MySQL/Postgres set DB_ENGINE and the rest.
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=mindful_blog
# DB_USER=blog
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# Seconds to hold a connection open between requests. 0 opens a new one each
# time; 60 is a sensible floor on a managed database where connecting is slow.
# DB_CONN_MAX_AGE=0

# JWT ---------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Email — Brevo (recommended) ----------------------------------------------
# Brevo (brevo.com, formerly Sendinblue) handles delivery when a key is set,
# and takes precedence over the SMTP settings below.
#
# It is the only way to get newsletter open and click rates: tracking requires
# rewriting links and embedding a pixel, which only the sending service can do.
# A plain SMTP server physically cannot report them.
#
# Get a key at https://app.brevo.com under SMTP & API -> API Keys.
# BREVO_LIST_ID is the contact list confirmed subscribers are added to.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_LIST_ID=0

# Email — SMTP fallback ----------------------------------------------------
# Leave EMAIL_HOST_USER/PASSWORD blank to print emails to the console instead
# of delivering them, which is usually what you want in local development.
#
# For Gmail, EMAIL_HOST_PASSWORD must be an App Password, not the account
# password: turn on 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords. Google displays it as four groups
# of four; the spaces are stripped automatically, so pasting it as shown works.
#
# Verify a change with:  python manage.py check_email --send
# Settings are read once at startup, so restart the server after editing this file.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Most providers refuse to send as an address the authenticated account does not
# own. Leave this blank to send as EMAIL_HOST_USER, which always works.
DEFAULT_FROM_EMAIL=
SITE_NAME=Mindful Blog
# Set to False to let users log in without confirming the emailed code.
REQUIRE_EMAIL_VERIFICATION=True
LOGIN_CODE_TTL_MINUTES=10

# Throttling --------------------------------------------------------------
THROTTLE_USER=2000/day
THROTTLE_ANON=300/day
THROTTLE_AUTH=20/hour
THROTTLE_REGISTER=10/hour
THROTTLE_WRITE=120/hour

# Uploads -----------------------------------------------------------------
MAX_IMAGE_UPLOAD_SIZE=
# Largest request body Django will buffer in memory, in bytes. Raise it only
# if a legitimate upload is being rejected.
# DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# Pagination --------------------------------------------------------------
PAGE_SIZE=

# Social sign-in (optional) -----------------------------------------------
# A provider with no credentials is simply not offered by /api/auth/providers/,
# so leaving these blank disables the button rather than breaking the page.
GITHUB_CLIENT_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Must match the redirect URI registered with Google for this client.
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback/google

# Password reset ----------------------------------------------------------
# How long an emailed reset link stays usable.
PASSWORD_RESET_TTL_MINUTES=30

# Media storage -----------------------------------------------------------
# Leave blank for local development: uploads go to media/ exactly as before.
# Set all three in production — Render's filesystem is ephemeral, so anything
# written to media/ there is lost on the next deploy or restart.
# Get them from https://console.cloudinary.com (Dashboard -> Product Environment).
# CLOUDINARY_API_SECRET is server-side only. Never send it to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# reCAPTCHA (optional) -----------------------------------------------------
# Guards registration, password reset and newsletter sign-up — the three
# unauthenticated endpoints that create an account or email an address the
# requester chose. Leave the secret blank to switch the guard off entirely.
#
# Register a site at https://www.google.com/recaptcha/admin.
# The SITE key is public and is served to the frontend by /api/config/.
# The SECRET key is server-side only and must never reach the frontend.
RECAPTCHA_ENABLED=True
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Only used by v3 keys, which return a score. v2 sends none and passes on
# success alone. 0.5 is Google's suggested starting point.
RECAPTCHA_MIN_SCORE=0.5

# AI assistant (optional) --------------------------------------------------
# Leave NVIDIA_API_KEY blank to disable: the endpoints report themselves as
# unavailable and the editor hides the assistant rather than offering buttons
# that fail. Get a key at https://build.nvidia.com.
#
# NOTE: a shell `export NVIDIA_MODEL=...` overrides this file — python-decouple
# reads the process environment first. On Render, set these as env vars.
AI_ENABLED=True
AI_PREFERRED_PROVIDER=nvidia
NVIDIA_API_KEY=
# Verified working. Both reason before answering, which is why the client
# budgets generously and retries once on a truncated reply.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_FAST_MODEL=openai/gpt-oss-20b
NVIDIA_TRANSLATE_MODEL=nvidia/riva-translate-4b-instruct-v2
NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
# Powers semantic search and vector-based related posts. Only two embedding
# models are enabled on a typical NVIDIA account; this one was chosen by
# measuring how cleanly it separates related from unrelated text.
# Re-run `manage.py build_search_index --force` after changing it — vectors
# from two different models must never be compared.
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# AI calls cost money per request, so they get their own throttle budget.
THROTTLE_AI=40/hour

# Cache -------------------------------------------------------------------
# Throttle counters live in a file-based cache, so every worker on a host
# shares one rate-limit budget with no extra service to run. Defaults to
# .cache/ next to manage.py; set this if that directory is not writable
# (on Render, use a path under /tmp).
CACHE_DIR=
